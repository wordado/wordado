{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is local development and tests only; a deploy always names --env production
  // (spec 2026-10-05 §14). Its own name means a bare `wrangler deploy` can never replace the real Worker.
  "name": "wordado-review-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "wordado-review", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "wordado-review" }],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:4181",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "CONTENT_REPO": "wordado/wordado-content",
    // The public app repository: its open issues are read once a day, without a token (spec 2026-10-10 §3.3).
    "APP_REPO": "wordado/wordado",
    // The prepared notices the Mail tab offers (#215): the repository and the folder in it. Empty, none is offered.
    "NOTICES_REPO": "",
    "NOTICES_PATH": "",
    "GITHUB_APP_ID": "",
    "GITHUB_INSTALLATION_ID": "",
    "MAIL_FROM": "Wordado Review <review@wordado.com>",
    "LEARNER_APP_URL": "",
    // The AI help on feedback (spec 2026-10-10 §4): how the Worker signs in (key, or google-service-account), the
    // service the model is reached through, the model, the calls a UTC day, the languages that need no translation.
    "FEEDBACK_AI_AUTH": "key",
    "FEEDBACK_AI_URL": "https://openrouter.ai/api/v1",
    "FEEDBACK_AI_MODEL": "google/gemini-3.8-flash",
    "FEEDBACK_AI_DAILY_CALLS": "200",
    "FEEDBACK_READS": "en,bg"
  },
  // The weekly feedback mail (spec 2026-10-10 §3.4): Monday 06:00 UTC, and its second try on Tuesday. The open issues
  // of the app's repository (§3.3): every day, 05:00 UTC. Each line has its job in worker/index.ts. Written here and
  // in env.production, so nothing depends on what an environment inherits.
  "triggers": { "crons": ["0 6 * * 1", "0 6 * * 2", "0 5 * * *"] },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "wordado-review",
      "routes": [{ "pattern": "review.wordado.com", "custom_domain": true }],
      // The operator's ids and values (review-app/README.md, "Hosted"); scripts/check-config.ts refuses
      // a deploy while any is still the placeholder. ADMIN_EMAIL, FEEDBACK_READ_TOKEN, ADMIN_WRITE_TOKEN, FEEDBACK_AI_KEY and the keys are secrets, not vars.
      "d1_databases": [{ "binding": "DB", "database_name": "wordado-review", "database_id": "b52cb790-18a9-485d-8e40-4d78af13e324", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "wordado-review" }],
      // The weekly feedback mail, Monday 06:00 UTC, and its second try on Tuesday; the open issues, every day
      // 05:00 UTC (as at the top level).
      "triggers": { "crons": ["0 6 * * 1", "0 6 * * 2", "0 5 * * *"] },
      "vars": {
        "APP_ORIGIN": "https://review.wordado.com",
        "ACCESS_TEAM_DOMAIN": "wordado.cloudflareaccess.com",
        "ACCESS_AUD": "01070f9e8cb88c84b710cb53794ae60e5bb109c408fd474f679f571409b2125b",
        "CONTENT_REPO": "wordado/wordado-content",
        // The public app repository, whose open issues the AI help matches topics against (spec 2026-10-10 §3.3).
        // They are read from GitHub's public API with no token: the review app has no access to that repository.
        "APP_REPO": "wordado/wordado",
        // The notices prepared with a change, which the Mail tab offers to a service notice (#215): the repository
        // as owner/name and the folder in it, read through the GitHub App below, which must be installed on that
        // repository too. Both empty, nothing is read and nothing is offered (review-app/README.md, "Prepared notices").
        "NOTICES_REPO": "",
        "NOTICES_PATH": "",
        "GITHUB_APP_ID": "5208152",
        "GITHUB_INSTALLATION_ID": "168429558",
        "MAIL_FROM": "Wordado Review <review@wordado.com>",
        // The learner app's server, for the Feedback tab (spec 2026-10-05 §16) and the Accounts tab (§17); their tokens,
        // FEEDBACK_READ_TOKEN and ADMIN_WRITE_TOKEN, are secrets.
        "LEARNER_APP_URL": "https://app.wordado.com",
        // The AI help on feedback (spec 2026-10-10 §4): how the Worker signs in to the service the model is reached
        // through, that service's address (https), the model as it names it, the calls a UTC day, the languages
        // that need no translation. FEEDBACK_AI_AUTH is "key" (FEEDBACK_AI_KEY is the service's key; any service
        // that takes the same request) or "google-service-account" (FEEDBACK_AI_KEY is the account's JSON key
        // file, and FEEDBACK_AI_URL must be an address on googleapis.com). FEEDBACK_AI_KEY is a secret; without it
        // there is no AI help. With it, the help is still off until an admin switches it on in the Feedback tab.
        // Production asks the model's provider directly, at its endpoint for the European Union; {project} is
        // filled from the key file, so no project is written here. That this endpoint takes the request at this
        // path is to be confirmed by the first real call; should it not, the regional form is the fallback:
        // https://<region>-aiplatform.googleapis.com/v1/projects/{project}/locations/<region>/endpoints/openapi
        // with a model that region has.
        "FEEDBACK_AI_AUTH": "google-service-account",
        "FEEDBACK_AI_URL": "https://aiplatform.eu.rep.googleapis.com/v1/projects/{project}/locations/eu/endpoints/openapi",
        "FEEDBACK_AI_MODEL": "google/gemini-3.8-flash",
        "FEEDBACK_AI_DAILY_CALLS": "200",
        "FEEDBACK_READS": "en,bg"
      }
    }
  }
}
